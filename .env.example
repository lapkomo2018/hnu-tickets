APP_ENV=development
APP_PORT=8080

# PostgreSQL connection. Docker Compose uses the same credentials for the
# database container. The host is the postgres service inside Compose; use
# localhost when the API runs on the host.
POSTGRES_HOST=postgres
POSTGRES_DB=tickets
POSTGRES_USER=tickets
POSTGRES_PASSWORD=tickets
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL=24h
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: administrator created on startup when no user with this email exists.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Data encryption: generate a separate 32-byte key with openssl rand -base64 32.
# Replace the placeholder; keep the real value outside Git. Retain old IDs during rotation.
DATA_ACTIVE_KEY=k1
DATA_KEYS={"k1":"replace-with-base64-32-byte-key"}
